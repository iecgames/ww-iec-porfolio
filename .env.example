# Database connection string
DATABASE_URL=mongodb://127.0.0.1/your-database-name

# Or use a PG connection string
#DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=YOUR_SECRET_HERE

# MCP Server — API key for AI Agent access (legacy; still accepted alongside OAuth)
MCP_API_KEY=YOUR_MCP_API_KEY_HERE

# --- MCP OAuth 2.1 (embedded Authorization Server) ---
# Public base URL acting as the OAuth issuer. No trailing slash.
# Defaults to the app's computed server URL (NEXT_PUBLIC_SERVER_URL) if unset.
OAUTH_ISSUER=http://localhost:3000
# ES256 (EC P-256) private key, base64-encoded PEM (single line). The public key is
# derived from it at runtime (published at /api/oauth/jwks) — no public env needed.
# EC keeps the serverless env tiny (AWS Lambda has a 4KB env limit). Generate with:
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out priv.pem
#   base64 -w0 priv.pem   # -> OAUTH_JWT_PRIVATE_KEY
OAUTH_JWT_PRIVATE_KEY=
OAUTH_JWT_KID=iec-mcp-1
OAUTH_ACCESS_TOKEN_TTL=3600
OAUTH_REFRESH_TOKEN_TTL=2592000

# Optional: set to true to show verbose error messages (not recommended in production)
VERBOSE_ERRORS=true

# Email provider: nodemailer (SMTP) | resend
# Defaults to nodemailer if not set
EMAIL_PROVIDER=resend

# Display name and address used in the From header of all outgoing emails
EMAIL_FROM_NAME=IEC
EMAIL_FROM=noreply@example.com

# --- SMTP settings (only required when EMAIL_PROVIDER=nodemailer) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# --- Resend settings (only required when EMAIL_PROVIDER=resend) ---
RESEND_API_KEY=re_ssss

# Storage provider for uploaded media: local | minio | gcs
# - local: stores files under public/media (default)
# - minio: stores files in a MinIO bucket (S3-compatible)
# - gcs:   stores files in a Google Cloud Storage bucket
STORAGE_PROVIDER=local

# MinIO settings (only required when STORAGE_PROVIDER=minio)
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_BUCKET=iec-media
MINIO_ACCESS_KEY_ID=YOUR_MINIO_ACCESS_KEY
MINIO_SECRET_ACCESS_KEY=YOUR_MINIO_SECRET_KEY
# Optional, defaults to us-east-1. MinIO ignores region but the S3 SDK requires one.
MINIO_REGION=us-east-1

# Google Cloud Storage (only required when STORAGE_PROVIDER=gcs)
GCS_BUCKET=iec-media
# Optional — inferred from credentials if omitted
GCS_PROJECT_ID=your-gcp-project-id
# Choose ONE auth method:
#   1) GCS_KEY_FILE: absolute path to a service-account JSON key file (recommended for local dev)
#   2) GCS_CREDENTIALS: base64-encoded service-account JSON (recommended for Docker/Coolify;
#      raw JSON gets mangled by env-var layers). Generate with: base64 -w0 key.json
#   3) Leave both empty to use Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS, workload identity, etc.)
GCS_KEY_FILE=
GCS_CREDENTIALS=

CLOUDFLARE_TUNNEL_TOKEN=