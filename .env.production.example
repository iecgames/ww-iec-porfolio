# Template .env cho deploy VPS. Copy thành `.env` TRÊN VPS rồi điền giá trị.
# KHÔNG commit bản đã điền.
#
# Trạng thái từng biến, đối chiếu với Netlify site `ww-iec`:
#   [BẠN]  chỉ bạn cung cấp được — Netlify mask secret ở server, không đọc lại được
#   [MỚI]  sinh mới, an toàn
#   [BIẾT] đã biết chắc giá trị

# ─────────────────────────────────────────────────────────
# Domain — quyết định TRƯỚC khi build
# ─────────────────────────────────────────────────────────
# Host cho router Traefik + cert Let's Encrypt.
SITE_HOST=ww-iec.haleinteractive.vn

# [BIẾT] Nhúng vào client bundle LÚC BUILD. Sai là phải build lại, không phải
# sửa file rồi restart. Không có dấu / ở cuối.
NEXT_PUBLIC_SERVER_URL=https://ww-iec.haleinteractive.vn

# [BIẾT] Issuer của OAuth. Netlify đang để "https://ww-iec.netlify.app/" —
# dấu / thừa làm lệch so khớp issuer. Ở đây cố ý bỏ.
OAUTH_ISSUER=https://ww-iec.haleinteractive.vn

# Cổng bind localhost cho cron trên host gọi vào.
# Tên là HOST_PORT chứ KHÔNG phải PORT — server.js của Next cũng đọc biến PORT
# giữ 3002 cho nhất quán.
HOST_PORT=3002

# ─────────────────────────────────────────────────────────
# Bắt buộc — CHẶN toàn bộ deploy nếu thiếu
# ─────────────────────────────────────────────────────────
# [BẠN] Mongo production. Không tái tạo được từ bất cứ đâu.
# Cẩn thận: .env dev trỏ Mongo DEV (project be-dev-20230316), khác hẳn prod.
# Dùng nhầm là site chạy trên dữ liệu dev mà không có lỗi nào báo.
DATABASE_URL=

# [MỚI] Xoay được an toàn: đã kiểm không field nào `encrypted: true`, không
# `useAPIKey`. Hệ quả duy nhất là admin phải đăng nhập lại.
#   openssl rand -hex 32
PAYLOAD_SECRET=

# ─────────────────────────────────────────────────────────
# Secret sinh mới — không cần khôi phục bản cũ
# ─────────────────────────────────────────────────────────
#   openssl rand -hex 24
CRON_SECRET=
PREVIEW_SECRET=

# [MỚI] EC P-256, base64 PEM một dòng. Sinh mới chỉ làm token MCP cũ hết hiệu lực.
#   openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out priv.pem
#   base64 -w0 priv.pem
OAUTH_JWT_PRIVATE_KEY=
# [BIẾT] Netlify đọc được (không đánh dấu secret).
OAUTH_JWT_KID=iec-mcp-1
OAUTH_ACCESS_TOKEN_TTL=3600
OAUTH_REFRESH_TOKEN_TTL=2592000

# ─────────────────────────────────────────────────────────
# Google Cloud Storage
# ─────────────────────────────────────────────────────────
# [BIẾT] Netlify đọc được. Lưu ý bucket dev là `iec-media`, KHÁC bucket này.
GCS_BUCKET=iec-media-prod
# [BIẾT] Đuôi mask trên Netlify là `8203`, khớp be-production-398203.
GCS_PROJECT_ID=be-production-398203
GCS_KEY_FILE=

# [BẠN] base64 service-account JSON có quyền đọc/ghi bucket iec-media-prod.
# Netlify mask nên phải mint key MỚI trong be-production-398203, hoặc lấy lại
# từ nơi bản gốc được tạo ra.
#   base64 -w0 key.json
GCS_CREDENTIALS=

# [BIẾT] khớp env dev
STORAGE_PROVIDER=gcs
VERBOSE_ERRORS=false

# ─────────────────────────────────────────────────────────
# Email — Netlify KHÔNG cấu hình, nên các luồng gửi mail đang im lặng không chạy.
# Để trống thì giữ nguyên hành vi hiện tại; điền vào là bật lên.
# ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=IEC
# Để trống thì dùng NEXT_PUBLIC_SERVER_URL — thường là điều bạn muốn.
SITE_URL=
